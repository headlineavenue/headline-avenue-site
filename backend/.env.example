APP_NAME=Headline Avenue API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./headline_avenue.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,https://headlineavenue.github.io
FRONTEND_ORIGIN=http://localhost:5500

# TikTok Login Kit / Content Posting sandbox
# Keep the client secret only in backend/.env. Never expose it to frontend JavaScript.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.publish
