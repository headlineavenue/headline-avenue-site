APP_NAME=Headline Avenue API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./headline_avenue.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,https://headlineavenue.github.io,https://headlineavenue.com,https://www.headlineavenue.com
FRONTEND_ORIGIN=http://localhost:5500

# Browser authentication. Production automatically forces Secure cookies.
AUTH_COOKIE_NAME=ha_session
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Development defaults to registration enabled. Production defaults to disabled
# unless explicitly set true.
AUTH_REGISTRATION_ENABLED=true
AUTH_BOOTSTRAP_OWNER_EMAIL=
AUTH_BOOTSTRAP_OWNER_PASSWORD=
AUTH_BOOTSTRAP_OWNER_NAME=Headline Avenue Owner

# Generate once for production with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# TikTok Login Kit sandbox
# Keep the client secret only in backend/.env. Never expose it to frontend JavaScript.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic

# Private media storage.
# Local development writes under backend/data/uploads by default.
# Production should use an S3-compatible private bucket such as Cloudflare R2.
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_DIR=./data/uploads
MEDIA_MAX_UPLOAD_MB=500
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_REGION=auto

# Timestamped speech-to-text
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_API_BASE=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
# "multi" supports multilingual news/interview inputs. Pin a language code later
# when the source language is known and cost/accuracy tradeoffs justify it.
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_DIARIZE=true
INGESTION_WORKER_POLL_SECONDS=2
